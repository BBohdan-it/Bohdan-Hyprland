{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "modules": [
    "title",
    "separator",
    {
      "type": "custom",
      "format": "{#blue}╭──────────────────────── HARDWARE ─────────────────────────╮"
    },
    {
      "type": "host",
      "key": "󰌢 PC      ",
      "keyColor": "#89B4FA"
    },
    {
      "type": "display",
      "key": "󰍺 DISPLAY ",
      "keyColor": "#89B4FA"
    },
    {
      "type": "cpu",
      "key": " CPU     ",
      "keyColor": "#89B4FA"
    },
    {
      "type": "gpu",
      "key": "󰢮 GPU     ",
      "keyColor": "#89B4FA"
    },
    {
      "type": "memory",
      "key": " MEMORY  ",
      "keyColor": "#89B4FA"
    },
    {
      "type": "custom",
      "format": "{#blue}╰───────────────────────────────────────────────────────────╯"
    },
    "break",
    {
      "type": "custom",
      "format": "{#blue}╭──────────────────────── SOFTWARE ─────────────────────────╮"
    },
    {
      "type": "os",
      "key": " OS      ",
      "keyColor": "#89B4FA"
    },
    {
      "type": "kernel",
      "key": " KERNEL  ",
      "keyColor": "#89B4FA"
    },
    {
      "type": "wm",
      "key": " WM      ",
      "keyColor": "#89B4FA"
    },
    {
      "type": "terminal",
      "key": " TERM    ",
      "keyColor": "#89B4FA"
    },
    {
      "type": "shell",
      "key": " SHELL   ",
      "keyColor": "#89B4FA"
    },
    {
      "type":  "packages",
      "key": "󰏗 PACKS   ",
      "keyColor": "#89B4FA"
    },
    {
      "type":  "uptime",
      "key": " UPTIME  ",
      "keyColor": "#89B4FA"
    },
    {
      "type": "custom",
      "format": "{#blue}╰───────────────────────────────────────────────────────────╯"
    },
    {
      "type": "colors",
      "paddingLeft": 2,
      "symbol": "circle"
    }
  ]
}
